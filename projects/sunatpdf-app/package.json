{
  "name": "sunatpdf-app",
  "version": "0.2.0",
  "description": "Convierte XMLs UBL de SUNAT (boletas, facturas, notas) a PDFs personalizables con tu marca.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test test/parser.test.mjs",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/poppins": "^5.1.0",
    "@imggion/html2realpdf": "^0.2.0",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "vite": "^5.4.10"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sunat",
    "ubl",
    "xml",
    "pdf",
    "factura",
    "boleta",
    "electronica",
    "peru",
    "comprobante"
  ]
}
