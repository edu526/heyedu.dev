{
  "name": "profile",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:sunatpdf": "pnpm --filter sunatpdf-app dev",
    "build": "pnpm --filter sunatpdf-app build && rm -rf public/sunatpdf && cp -r projects/sunatpdf-app/dist public/sunatpdf && astro build",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "pnpm --filter sunatpdf-app test",
    "assets": "pnpm --filter sunatpdf-app assets"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.17.1",
    "simple-icons": "^16.10.0",
    "tailwindcss": "^4.2.1"
  }
}